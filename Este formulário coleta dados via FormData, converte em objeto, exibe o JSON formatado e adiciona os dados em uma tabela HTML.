<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Questão 03 - Cadastro de Alunos</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 350px;
        }
        input, select, button {
            padding: 8px;
        }
        table {
            margin-top: 20px;
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid gray;
            padding: 8px;
            text-align: left;
        }
        pre {
            background-color: #eee;
            padding: 10px;
            overflow-x: auto;
        }
    </style>
</head>
<body>

    <h1>Cadastro de Alunos</h1>
    <form id="meuForm">
        <label for="nome">Nome:</label>
        <input type="text" id="nome" name="nome" required>

        <label for="email">E-mail:</label>
        <input type="email" id="email" name="email" required>

        <label for="idade">Idade:</label>
        <input type="number" id="idade" name="idade" required min="1" max="120">

        <label for="curso">Curso:</label>
        <select id="curso" name="curso" required>
            <option value="" disabled selected>Selecione um curso</option>
            <option value="Computação">Computação</option>
            <option value="Engenharia">Engenharia</option>
            <option value="Administração">Administração</option>
        </select>

        <button type="submit">Cadastrar</button>
    </form>

    <h2>Objeto JSON</h2>
    <pre id="json"></pre>

    <h2>Alunos cadastrados</h2>
    <table id="tabelaAlunos">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Idade</th>
                <th>Curso</th>
            </tr>
        </thead>
        <tbody>
            <!-- Linhas adicionadas via JavaScript -->
        </tbody>
    </table>

    <script>
        const form = document.getElementById("meuForm");
        const preJson = document.getElementById("json");
        const tbodyTabela = document.querySelector("#tabelaAlunos tbody");

        form.addEventListener("submit", (evento) => {
            evento.preventDefault(); // Evita recarregar a página

            const formData = new FormData(form);
            const objeto = {};

            for (let [chave, valor] of formData.entries()) {
                objeto[chave] = valor;
            }

            // Exibe o JSON formatado
            preJson.textContent = JSON.stringify(objeto, null, 2);

            // Adiciona nova linha na tabela
            const novaLinha = document.createElement("tr");
            novaLinha.innerHTML = `
                <td>${objeto.nome}</td>
                <td>${objeto.email}</td>
                <td>${objeto.idade}</td>
                <td>${objeto.curso}</td>
            `;
            tbodyTabela.appendChild(novaLinha);

            form.reset(); // Opcional: limpa o formulário após o envio
        });
    </script>
</body>
</html>
