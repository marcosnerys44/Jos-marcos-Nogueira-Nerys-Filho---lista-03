<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Questão 02 - Buscar Post</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        input, button {
            padding: 8px;
        }
        #resultado {
            margin-top: 20px;
        }
        .erro {
            color: red;
        }
    </style>
</head>
<body>

    <h1>Buscar Post</h1>
    <input type="number" id="txtId" placeholder="Digite o ID">
    <button id="btnBuscar">Buscar</button>

    <div id="resultado"></div>

    <script>
        const posts = [
            { userId: 1, id: 1, title: "Primeiro post", body: "Aprendendo a manipular o DOM." },
            { userId: 1, id: 2, title: "Segundo post", body: "Arrays de objetos são parecidos com o JSON de uma API." },
            { userId: 2, id: 3, title: "Terceiro post", body: "Em breve vamos buscar estes dados no servidor." },
            { userId: 2, id: 4, title: "Quarto post", body: "O método find devolve o primeiro item encontrado." },
            { userId: 3, id: 5, title: "Quinto post", body: "Se nada for encontrado, find devolve undefined." }
        ];

        document.getElementById("btnBuscar").addEventListener("click", () => {
            const inputId = document.getElementById("txtId").value;
            const divResultado = document.getElementById("resultado");
            divResultado.innerHTML = ""; // Limpa resultados anteriores

            if (inputId === "") {
                divResultado.innerHTML = `<span class="erro">Digite um ID.</span>`;
                return;
            }

            const idBuscado = Number(inputId);
            const postEncontrado = posts.find(p => p.id === idBuscado);

            if (!postEncontrado) {
                divResultado.innerHTML = `<span class="erro">Post não encontrado (ID ${idBuscado}). Os IDs válidos vão de 1 a 5.</span>`;
            } else {
                divResultado.innerHTML = `
                    <h2>${postEncontrado.title}</h2>
                    <p>${postEncontrado.body}</p>
                `;
            }
        });
    </script>
</body>
</html>
